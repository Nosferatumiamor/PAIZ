{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PAIZ-WeightStream",
  "mainBinaryName": "PAIZ-WeightStream",
  "version": "0.3.1",
  "identifier": "com.paiz.dispenser",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PAIZ-WeightStream",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "PAIZ",
    "shortDescription": "The AI models dispenser",
    "longDescription": "PAIZ catalogue, range et échange tes modèles IA entre disques sans les re-télécharger.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/node.exe": "node.exe",
      "resources/app": "app",
      "resources/engine": "engine"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"],
        "displayLanguageSelector": true,
        "installerHooks": "windows/hooks.nsi"
      }
    }
  }
}
