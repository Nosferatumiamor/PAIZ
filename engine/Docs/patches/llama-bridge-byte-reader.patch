+namespace {
+
+struct llama_byte_reader_state {
+    llama_byte_read_fn fn = nullptr;
+    void *             userdata = nullptr;
+};
+
+llama_byte_reader_state & llama_byte_reader() {
+    static llama_byte_reader_state state;
+    return state;
+}
+
+bool llama_try_byte_read(uint64_t offset, void * ptr, size_t len) {
+    auto & reader = llama_byte_reader();
+    if (!reader.fn) {
+        return false;
+    }
+    return reader.fn(reader.userdata, offset, ptr, len);
+}
+
+} // namespace
+
+void llama_file_set_byte_reader(llama_byte_read_fn fn, void * userdata) {
+    auto & reader = llama_byte_reader();
+    reader.fn = fn;
+    reader.userdata = userdata;
+}
+
+void llama_file_clear_byte_reader() {
+    llama_file_set_byte_reader(nullptr, nullptr);
+}
