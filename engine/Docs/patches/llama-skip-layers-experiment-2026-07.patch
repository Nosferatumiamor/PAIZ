+void llama_context::set_skip_layer(uint32_t lid, bool skip) {
+    LLAMA_LOG_DEBUG("%s: lid = %d, skip = %d\n", __func__, lid, skip);
+
+    GGML_ASSERT(lid < model.hparams.n_layer());
+
+    cparams.skip_layers[lid] = skip;
+
+    // graph structure changes when a layer is skipped, same as embeddings_layer_inp
+    sched_need_reserve = true;
+}
+
+void llama_context::set_skip_scale(uint32_t lid, const float * data, size_t n) {
+    LLAMA_LOG_DEBUG("%s: lid = %d, n = %zu\n", __func__, lid, n);
+
+    GGML_ASSERT(lid < model.hparams.n_layer());
+
+    if (data == nullptr || n == 0) {
+        cparams.skip_scale[lid].clear();
+    } else {
+        cparams.skip_scale[lid].assign(data, data + n);
+    }
+
+    // graph structure changes when a patched skip is (de)activated, same as skip_layers
+    sched_need_reserve = true;
+}
