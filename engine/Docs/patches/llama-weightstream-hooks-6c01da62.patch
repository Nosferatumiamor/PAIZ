+
+//
+// MoE expert source
+//
+
+// an expert the MoE cache needs to upload to the device on a cache miss
+struct llama_moe_expert_read {
+    const struct ggml_tensor * tensor; // host tensor of stacked experts (ffn_*_exps), tensor->nb[2] bytes per expert
+    int64_t                    expert;
+    const void *               data;   // set by the source, must stay valid until its next call
+};
+
+// reads the experts of a MoE cache miss instead of tensor->data, which is an mmap that page-faults when the model
+// does not fit in host memory; called once per layer with all of its misses so they can be read in parallel
+// returns false to fall back to tensor->data for this layer
+typedef bool (*llama_moe_expert_source)(void * user_data, struct llama_moe_expert_read * reads, size_t n_reads);
+
+LLAMA_API void llama_moe_set_expert_source(llama_moe_expert_source source, void * user_data);
+
+// largest number of reads the expert source can serve in one call, 0 = no limit: a large batch (prefill) that needs more experts
+// of a layer than that is uploaded in slices instead of falling back to tensor->data (the mmap, which then fills the host memory)
+LLAMA_API void llama_moe_set_expert_source_limit(size_t max_reads);
+
+// reads bytes [offset, offset + nbytes) of the expert tensor `tensor_name` (GGUF name) with big sequential reads into dst (aligned to 4096, dst_capacity
+// bytes, which also covers the sector rounding): the data starts at dst + *skew. Used by the prefill of a big batch, which needs almost every expert of
+// a layer: the whole tensors are streamed from the SSD in order, read ahead into pinned staging buffers while the GPU computes the previous layer,
+// instead of one random read per expert. Called from a reader thread, returns false to fall back to the expert source
+typedef bool (*llama_moe_bulk_reader)(void * user_data, const char * tensor_name, size_t offset, size_t nbytes, void * dst, size_t dst_capacity, size_t * skew);
+
+LLAMA_API void llama_moe_set_bulk_reader(llama_moe_bulk_reader reader, void * user_data);
+
+// observes the experts selected for each token of every layer that goes through the MoE cache:
+// ids holds n_ids expert indices, n_expert_used per token, token by token
+typedef void (*llama_moe_expert_observer)(void * user_data, int32_t il, const int32_t * ids, size_t n_ids);
+
+LLAMA_API void llama_moe_set_expert_observer(llama_moe_expert_observer observer, void * user_data);
+
+// called during generation (WS_LOOK) with the experts of layer il predicted to be used soon and not in the VRAM cache, the expert source may read them ahead
+// (asynchronously: the call must not block)
+typedef void (*llama_moe_expert_prefetch)(void * user_data, int32_t il, const int32_t * experts, size_t n_experts);
+
+// the number of experts predicted for the next layer during generation (0 = lookahead off, the default; distance = how many layers ahead; env WS_LOOK sets the initial value)
+LLAMA_API void llama_moe_set_lookahead(int n_experts, int distance);
+
+LLAMA_API void llama_moe_set_expert_prefetch(llama_moe_expert_prefetch prefetch, void * user_data);
+
+// fills the free slots of the MoE cache with the given experts of layer il, no decode may run meanwhile
+// returns the number of experts uploaded, 0 if the context has no MoE cache
+LLAMA_API size_t llama_moe_cache_preload(struct llama_context * ctx, int32_t il, const int32_t * experts, size_t n_experts);
