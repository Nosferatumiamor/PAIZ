+static llama_moe_expert_source g_expert_source      = nullptr;
+static void *                  g_expert_source_user = nullptr;
+
+void llama_moe_set_expert_source(llama_moe_expert_source source, void * user_data) {
+    g_expert_source      = source;
+    g_expert_source_user = user_data;
+}
+
+static llama_moe_bulk_reader g_bulk_reader      = nullptr;
+static void *                g_bulk_reader_user = nullptr;
+
+void llama_moe_set_bulk_reader(llama_moe_bulk_reader reader, void * user_data) {
+    g_bulk_reader      = reader;
+    g_bulk_reader_user = user_data;
+}
+
+static size_t g_expert_source_limit = 0;
+
+void llama_moe_set_expert_source_limit(size_t max_reads) {
+    g_expert_source_limit = max_reads;
+}
+
+bool llama_moe_source_upload(ggml_backend_t backend, const ggml_tensor * w, ggml_tensor * dst, int64_t first, int64_t last_excl) {
+    if (g_expert_source == nullptr) {
+        return false;
+    }
+    const size_t  expert_size = w->nb[2];
+    const int64_t step        = g_expert_source_limit > 0 ? (int64_t) g_expert_source_limit : std::max<int64_t>(1, last_excl - first);
+    static const bool prof = std::getenv("WS_PROF") != nullptr;
+    static double t_src = 0, t_set = 0, t_sync = 0; static size_t n_calls = 0, n_exp = 0, n_slices = 0, n_fail = 0;
+    auto now = []() { return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count(); };
+    std::vector<llama_moe_expert_read> reads;
+    for (int64_t pos = first; pos < last_excl; ) {
+        const int64_t n = std::min(step, last_excl - pos);
+        reads.clear();
+        for (int64_t i = 0; i < n; i++) {
+            reads.push_back({w, pos + i, nullptr});
+        }
+        const double t0 = prof ? now() : 0;
+        const bool ok = g_expert_source(g_expert_source_user, reads.data(), reads.size()) &&
+            std::all_of(reads.begin(), reads.end(), [](const llama_moe_expert_read & r) { return r.data != nullptr; });
+        const double t1 = prof ? now() : 0;
+        for (int64_t i = 0; i < n; i++) {
+            const void * data = ok ? reads[i].data : (const void *) ((const uint8_t *) w->data + (pos + i)*expert_size);
+            ggml_backend_tensor_set_async(backend, dst, data, (pos + i)*expert_size, expert_size);
+        }
+        const double t2 = prof ? now() : 0;
+        ggml_backend_synchronize(backend); // the slots of this slice are reused by the next call
+        if (prof) {
+            const double t3 = now();
+            t_src += t1 - t0; t_set += t2 - t1; t_sync += t3 - t2; n_exp += n; ++n_slices; n_fail += ok ? 0 : 1;
+            if (++n_calls % 90 == 0) {
+                std::fprintf(stderr, "[ws_prof] slices=%zu experts=%zu fail=%zu | source %.2fs  set_async %.2fs  sync %.2fs\n", n_slices, n_exp, n_fail, t_src, t_set, t_sync);
+            }
+        }
+        pos += n;
+    }
+    return true;
